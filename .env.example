# ─────────────────────────────────────────────
# Binance API Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Get your API keys from:
#   Mainnet:  https://www.binance.com/en/my/settings/api-management
#   Testnet:  https://testnet.binance.vision/
#
# IMPORTANT: For your API key, enable these permissions:
#   - "Enable Reading" (required)
#   - "Enable Spot & Margin Trading" (required for live trading)
#   - DO NOT enable "Enable Withdrawals" (not needed, security risk)
#
# Recommended: Restrict API access to your IP address in Binance settings.
# ─────────────────────────────────────────────

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" for testnet, "false" for real mainnet
# ALWAYS start with testnet to validate your setup
BINANCE_TESTNET=true
